<UserControl x:Class="AutoStructure.MainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:AutoStructure"
             xmlns:vm="clr-namespace:AutoStructure.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             FontFamily="Segoe UI, Meiryo UI, sans-serif"
             FontSize="12"
             d:DesignHeight="800" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AutoStructureMaker_v2.0.4.esapi;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:OperationItemViewModel}">
                <local:UC_OperationCard />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource Theme.Background.Main}">
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="90" />
            </Grid.RowDefinitions>

            <!-- 1. 上部統合アクションバー -->
            <Border Grid.Row="0" Background="{StaticResource Theme.Background.Card}" 
                    BorderBrush="{StaticResource Theme.Border.Normal}" BorderThickness="1" 
                    CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08" Color="#000000" />
                </Border.Effect>
                <DockPanel LastChildFill="True">
                    <!-- 左側: メイン操作 (RUN, Check, Load, Save, ＋ Add Step) -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="runButton" Content="▶  RUN" Command="{Binding RunCommand}" 
                                Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" Margin="2,2,4,2" />
                        <Button x:Name="checkButton" Content="✔  Check" Command="{Binding ValidateCommand}" 
                                Height="32" Padding="10,0" Margin="2,2,6,2" FontWeight="SemiBold"
                                ToolTip="実行前に輪郭の存在やパラメータの整合性を一括検査 (Pre-Flight Check)" />
                        
                        <Rectangle Width="1" Height="22" Fill="{StaticResource Theme.Border.Normal}" Margin="6,2" />

                        <Button x:Name="loadParaButton" Content="Load Template" Command="{Binding LoadCommand}" 
                                Height="30" Margin="4,2" Padding="12,4" />
                        <Button x:Name="saveParaButton" Content="Save Template" Command="{Binding SaveCommand}" 
                                Height="30" Margin="4,2" Padding="12,4" />

                        <Rectangle Width="1" Height="22" Fill="{StaticResource Theme.Border.Normal}" Margin="6,2" />

                        <!-- 統合された ＋ Add Step ボタン -->
                        <Button x:Name="addStepButton" Content="＋  Add Step" Command="{Binding AddStepCommand}" 
                                Height="32" Margin="4,2" Padding="14,4" FontWeight="Bold"
                                Background="#E3F2FD" Foreground="#0277BD" BorderBrush="#90CAF9" />
                    </StackPanel>

                    <!-- 右側: プロトコル名 & ステップ数サマリー -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,4,0">
                        <TextBlock Text="Protocol:" FontWeight="SemiBold" Foreground="{StaticResource Theme.Text.Secondary}" 
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ProtocolName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="160" Height="26" VerticalContentAlignment="Center" Padding="4,0" 
                                 ToolTip="テンプレートプロトコル名" Margin="0,0,12,0" />

                        <Border Background="#ECEFF1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding OperationsSummaryText}" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="#455A64" />
                        </Border>

                        <Button x:Name="helpButton" Content="❓  Help" Command="{Binding OpenHelpCommand}" 
                                Height="28" Padding="10,2" Margin="2,0,0,0" FontWeight="SemiBold"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1"
                                ToolTip="総合技術・臨床運用マニュアル (PDF) を開く" />
                    </StackPanel>
                </DockPanel>
            </Border>
            
            <!-- 2. 輪郭操作ステップ一覧 (画面中央の大領域) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <ItemsControl x:Name="OperationsList" ItemsSource="{Binding Operations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Margin="0,0,6,0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3. 最下部: ログ出力コンソール (コンパクト配置) -->
            <Border Grid.Row="2" Background="{StaticResource Theme.Background.Card}" 
                    BorderBrush="{StaticResource Theme.Border.Normal}" BorderThickness="1" 
                    CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08" Color="#000000" />
                </Border.Effect>
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Background="#37474F" Padding="8,3" CornerRadius="3,3,0,0">
                        <TextBlock Text="EXECUTION LOG" FontSize="10" FontWeight="Bold" Foreground="#CFD8DC" />
                    </Border>
                    <TextBox x:Name="logTextBox" TextWrapping="Wrap" Text="{Binding LogText, Mode=OneWay}" 
                             IsReadOnly="True" Padding="8,4" BorderThickness="0" Background="#FAFAFA"
                             FontFamily="Consolas, Meiryo UI, monospace" FontSize="11" Foreground="#37474F"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
